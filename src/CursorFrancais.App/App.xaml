<Application x:Class="CursorFrancais.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CursorFrancais.App.Converters"
             xmlns:vm="clr-namespace:CursorFrancais.App.ViewModels"
             xmlns:views="clr-namespace:CursorFrancais.App.Views"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:PageVisibilityConverter x:Key="PageVisibilityConverter" />
            <conv:DisponibiliteConverter x:Key="DispoConverter" />
            <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
            <DataTemplate DataType="{x:Type vm:PageStateViewModel}">
                <views:PlaceholderPanel />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
