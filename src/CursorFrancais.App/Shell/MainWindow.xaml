<Window x:Class="CursorFrancais.App.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="{Binding TitreFenetre}"
        Height="640"
        Width="920"
        MinHeight="480"
        MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        AutomationProperties.Name="Cursor Français Companion">
    <DockPanel>
        <tb:TaskbarIcon x:Name="NotifyIcon"
                        ToolTipText="Cursor Français Companion"
                        MenuActivation="LeftOrRightClick"
                        TrayMouseDoubleClick="OnTrayOuvrir">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Activer la traduction"
                              Click="OnTrayActiver"
                              AutomationProperties.Name="Activer la traduction" />
                    <MenuItem Header="Ouvrir"
                              Click="OnTrayOuvrir"
                              AutomationProperties.Name="Ouvrir la fenêtre" />
                    <MenuItem Header="Quitter"
                              Click="OnTrayQuitter"
                              AutomationProperties.Name="Quitter" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <Border DockPanel.Dock="Top"
                Background="{StaticResource BannerBgBrush}"
                Padding="16,8">
            <TextBlock Foreground="{StaticResource BannerTextBrush}"
                       Text="{Binding BandeauNonAffilie}"
                       AutomationProperties.Name="Mention non affilié" />
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource PanelBrush}"
                Padding="16,8">
            <TextBlock Style="{StaticResource MutedText}"
                       Text="Fermer la fenêtre laisse l’icône dans la zone de notification. Quitter se fait depuis le menu de l’icône." />
        </Border>

        <Border DockPanel.Dock="Left"
                Width="220"
                Background="{StaticResource PanelBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Margin="16,16,16,8"
                           FontWeight="SemiBold"
                           Text="Modules" />
                <ListBox ItemsSource="{Binding Modules}"
                         SelectedItem="{Binding SelectedModule}"
                         Margin="8"
                         AutomationProperties.Name="Menu des modules">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="8,6">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                <TextBlock FontSize="11"
                                           Style="{StaticResource MutedText}"
                                           Text="{Binding IsAvailable, Converter={StaticResource DispoConverter}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ContentControl Margin="20" Content="{Binding CurrentView}" />
    </DockPanel>
</Window>
