<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>CursorFrancais.App</RootNamespace>
    <AssemblyName>CursorFrancais.App</AssemblyName>
    <ApplicationTitle>Cursor Français Companion</ApplicationTitle>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CursorFrancais.Core\CursorFrancais.Core.csproj" />
    <ProjectReference Include="..\CursorFrancais.Automation\CursorFrancais.Automation.csproj" />
    <ProjectReference Include="..\CursorFrancais.Overlay\CursorFrancais.Overlay.csproj" />
    <ProjectReference Include="..\CursorFrancais.Native\CursorFrancais.Native.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
  </ItemGroup>
</Project>
