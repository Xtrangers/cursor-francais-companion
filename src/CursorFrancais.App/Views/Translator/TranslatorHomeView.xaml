<UserControl x:Class="CursorFrancais.App.Views.Translator.TranslatorHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Accueil traducteur">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Traducteur" />
            <TextBlock Margin="0,6,0,16"
                       Style="{StaticResource MutedText}"
                       Text="Overlay local de l’interface Cursor. Le code, les fichiers et les réponses de l’agent restent inchangés." />

            <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Content="Réessayer"
                            Command="{Binding ReessayerStatutCommand}"
                            AutomationProperties.Name="Réessayer la détection de Cursor"
                            VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Statut Cursor" />
                        <TextBlock Margin="0,6,0,0" Text="{Binding Statut.Message}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <CheckBox Content="Activer la traduction française"
                              IsChecked="{Binding TranslationEnabled}"
                              AutomationProperties.Name="Activer la traduction française" />
                    <TextBlock Margin="24,4,0,0"
                               Style="{StaticResource MutedText}"
                               Text="{Binding LibelleActivation}" />
                    <CheckBox Content="Mode bilingue (français — anglais)"
                              IsChecked="{Binding BilingualMode}"
                              AutomationProperties.Name="Mode bilingue" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Mode" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <RadioButton Content="Intelligent"
                                     GroupName="ModeTrad"
                                     IsChecked="{Binding ModeIntelligent}"
                                     AutomationProperties.Name="Mode intelligent" />
                        <RadioButton Content="Automatique"
                                     GroupName="ModeTrad"
                                     IsChecked="{Binding ModeAutomatique}"
                                     AutomationProperties.Name="Mode automatique" />
                        <RadioButton Content="Manuel"
                                     GroupName="ModeTrad"
                                     IsChecked="{Binding ModeManuel}"
                                     AutomationProperties.Name="Mode manuel" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Zones" />
                    <CheckBox Content="Agent et Chat"
                              IsChecked="{Binding TranslateAgentChat}"
                              AutomationProperties.Name="Traduire Agent et Chat" />
                    <CheckBox Content="Composer"
                              IsChecked="{Binding TranslateComposer}"
                              AutomationProperties.Name="Traduire Composer" />
                    <CheckBox Content="Réglages Cursor"
                              IsChecked="{Binding TranslateSettingsZone}"
                              AutomationProperties.Name="Traduire les réglages Cursor" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
