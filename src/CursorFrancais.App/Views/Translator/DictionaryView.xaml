<UserControl x:Class="CursorFrancais.App.Views.Translator.DictionaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Dictionnaire">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" FontSize="20" FontWeight="SemiBold" Text="Dictionnaire" />
        <TextBlock DockPanel.Dock="Top"
                   Margin="0,8,0,12"
                   Style="{StaticResource MutedText}"
                   Text="Termes locaux EN → FR. Rien n’est envoyé sur Internet." />
        <ContentControl Content="{Binding Dictionnaire}" />
    </DockPanel>
</UserControl>
